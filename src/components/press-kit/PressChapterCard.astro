---
const { eyebrow, title, descriptor, copy, href = "#", image, index = "01" } = Astro.props;
---
<a
  href={href}
  class="group relative overflow-hidden rounded-[1.85rem] border border-white/15 bg-black/55 transition duration-300 hover:border-gold/35 hover:shadow-[0_0_70px_rgba(242,84,45,0.12)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold"
>
  <div class="absolute inset-0">
    <img src={image} alt="" aria-hidden="true" class="h-full w-full object-cover opacity-35 transition duration-500 group-hover:scale-[1.04] group-hover:opacity-45" loading="lazy" />
    <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(7,7,11,0.1),rgba(7,7,11,0.88)_64%,rgba(7,7,11,0.98))]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(243,211,139,0.16),transparent_36%)]"></div>
  </div>
  <div class="relative flex min-h-[26rem] flex-col justify-between p-6">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="text-[10px] uppercase tracking-[0.3em] text-gold/90">{eyebrow}</p>
        <h3 class="mt-3 font-display text-4xl leading-none text-white">{title}</h3>
      </div>
      <span class="rounded-full border border-white/15 bg-black/35 px-3 py-1 text-[10px] uppercase tracking-[0.24em] text-white/55">{index}</span>
    </div>
    <div>
      <p class="text-sm uppercase tracking-[0.22em] text-white/55">{descriptor}</p>
      <p class="mt-4 max-w-md text-sm leading-relaxed text-white/74">{copy}</p>
      <span class="mt-6 inline-flex items-center gap-2 text-[10px] uppercase tracking-[0.28em] text-gold/90">
        Open Chapter
        <span aria-hidden="true">+</span>
      </span>
    </div>
  </div>
</a>
