---
const { label, value, detail = "" } = Astro.props;
---
<article class="rounded-[1.5rem] border border-white/12 bg-[linear-gradient(180deg,rgba(255,255,255,0.05),rgba(255,255,255,0.02))] p-5 shadow-[0_0_40px_rgba(242,84,45,0.06)]">
  <p class="text-[10px] uppercase tracking-[0.28em] text-white/45">{label}</p>
  <h3 class="mt-3 text-xl font-semibold leading-snug text-white/92">{value}</h3>
  {detail && <p class="mt-3 text-sm leading-relaxed text-white/68">{detail}</p>}
</article>
