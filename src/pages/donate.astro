---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import { isDonationPlaceholder } from "../lib/donate";

const source = Astro.url.searchParams.get("source") || "stream player";
const placeholder = Astro.url.searchParams.get("placeholder") === "1" || isDonationPlaceholder;
---

<BaseLayout
  title="Support The Performa | Donation"
  description="Support The Performa through a streamlined donation experience. Stripe checkout placeholder until the live donation account is connected."
>
  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <div class="rounded-[2.2rem] border border-white/15 bg-[linear-gradient(180deg,rgba(255,255,255,0.05),rgba(255,255,255,0.02))] p-6 md:p-8">
      <p class="text-[10px] uppercase tracking-[0.32em] text-gold/85">Support The Performa</p>
      <h1 class="mt-4 font-display text-4xl md:text-5xl">Donation checkout placeholder</h1>
      <p class="mt-4 text-sm leading-relaxed text-white/72 md:text-base">
        This donation button is now live across the stream players and ready to be connected to Stripe.
        {placeholder
          ? " The real Stripe donation account has not been connected yet, so this page is acting as the temporary destination."
          : " A live Stripe donation target is connected."}
      </p>
      <div class="mt-6 rounded-[1.4rem] border border-white/12 bg-black/35 p-5">
        <p class="text-[10px] uppercase tracking-[0.24em] text-white/50">Opened from</p>
        <p class="mt-2 text-base text-white/86">{source}</p>
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="mailto:booking@theperforma.com?subject=Donation%20Interest" variant="primary">Email Donation Interest</Button>
        <Button href="/watch" variant="ghost">Back to Watch</Button>
      </div>
    </div>
  </section>
</BaseLayout>
