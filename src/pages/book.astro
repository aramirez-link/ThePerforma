---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import BookingConciergeApp from "../components/booking/BookingConciergeApp";
---

<BaseLayout
  title="Booking Concierge | The Performa"
  description="Design a Performa event with an AI booking concierge, a live event blueprint modal, and Claude-powered questions. All submissions are preliminary and subject to human review."
>
  <section class="mx-auto max-w-5xl px-4 pt-6 pb-4 sm:px-6">
    <div class="rounded-[2rem] border border-white/12 bg-[linear-gradient(180deg,rgba(255,255,255,0.04),rgba(255,255,255,0.02))] p-6 md:p-8">
      <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-2xl">
          <p class="text-[10px] uppercase tracking-[0.32em] text-gold/85">Booking</p>
          <h1 class="mt-3 font-display text-4xl sm:text-5xl">Book The Performa</h1>
          <p class="mt-4 max-w-xl text-sm leading-relaxed text-white/70">
            Tell the AI what you&apos;re planning. It will build the event brief, estimate the range, and prepare the request for human review.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-4">
          <Button href="/media/press-kit.pdf" variant="primary">Download Press Kit</Button>
          <Button href="mailto:booking@theperforma.example" variant="ghost">Email Bookings</Button>
        </div>
      </div>
    </div>
  </section>

  <BookingConciergeApp client:only="react" />
</BaseLayout>
