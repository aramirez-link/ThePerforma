---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
import BookingConciergeApp from "../components/booking/BookingConciergeApp";

const enablePartnerCredit = import.meta.env.PUBLIC_ENABLE_PARTNER_CREDIT !== "false";
---
<BaseLayout title="Booking Concierge | The Performa" description="AI-guided booking concierge for designing a Performa event, generating preliminary estimates, and submitting for human review.">
  <section class="mx-auto max-w-6xl px-4 pt-8 sm:px-6">
    <div class="relative overflow-hidden rounded-[2rem] border border-white/15">
      <img src="/assets/img/137NewChip_4K.jpg" alt="" aria-hidden="true" class="h-[42vh] w-full object-cover opacity-40" />
      <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(7,7,11,0.3),rgba(7,7,11,0.92))]"></div>
      <div class="absolute inset-0 flex items-end p-5 md:p-8">
        <div>
          <p class="text-xs uppercase tracking-[0.34em] text-gold/90">AI Booking Concierge</p>
          <h1 class="mt-3 font-display text-4xl md:text-5xl">Design your Performa experience with a producer-grade concierge.</h1>
          <p class="mt-3 max-w-3xl text-sm text-white/75 md:text-base">Interview the event brief, shape a preliminary blueprint, review package fit and investment range, then submit for human review. Final booking is always subject to availability, approval, and contract execution.</p>
        </div>
      </div>
    </div>
  </section>
  <Section
    eyebrow="Concierge"
    title="Performa Event Architect™"
    subtitle="An AI-guided booking strategist that qualifies the lead, models the event, recommends package fit, and nudges the next best action."
  >
    <div class="mt-10 flex flex-wrap gap-4 items-center">
      <Button href="/media/press-kit.pdf" variant="primary">Download Press Kit</Button>
      <Button href="mailto:booking@theperforma.example" variant="ghost">Email Bookings</Button>
    </div>
    {enablePartnerCredit && (
      <div class="mt-4 max-w-xl rounded-2xl border border-white/10 bg-black/35 px-4 py-3">
        <p class="text-[11px] uppercase tracking-[0.24em] text-white/45">Credits</p>
        <dl class="mt-2 grid grid-cols-[auto,1fr] gap-x-4 gap-y-1 text-xs text-white/70">
          <dt class="text-white/45">Artist</dt>
          <dd>Chip Lee (The Performa)</dd>
          <dt class="text-white/45">Transformation Partner</dt>
          <dd>
            <a
              href="https://link-collective.com"
              target="_blank"
              rel="noopener noreferrer"
              class="text-white/75 transition hover:text-gold focus-visible:text-gold"
            >
              The LINK Collective
            </a>
          </dd>
        </dl>
      </div>
    )}
  </Section>
  <BookingConciergeApp client:only="react" />
</BaseLayout>

