---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MotionReveal from "../../components/MotionReveal";
import Button from "../../components/Button.astro";

const chapters = [
  {
    eyebrow: "Chapter I",
    title: "Exodus",
    copy: "The controlled arrival. Darkness, pressure, and the first real shift in the room.",
    href: "/story/exodus",
    image: "/assets/img/010ChipLee_CF2024_4K.jpg"
  },
  {
    eyebrow: "Chapter II",
    title: "Journey",
    copy: "The long-form stretch. Motion, blend architecture, and a bigger sense of scale.",
    href: "/story/journey",
    image: "/assets/img/096NewChip_4K.jpg"
  },
  {
    eyebrow: "Chapter III",
    title: "Return",
    copy: "The release. Brighter hooks, wider beams, and the crowd as part of the instrument.",
    href: "/story/return",
    image: "/assets/img/137NewChip_4K.jpg"
  }
];

const proofCards = [
  {
    title: "Luxury Energy",
    copy: "The Performa sits where nightlife authority, cinematic pacing, and brand-grade presentation intersect."
  },
  {
    title: "Promoter Ready",
    copy: "Built to sell rooms, elevate flyers, sharpen sponsor decks, and give media a clearer story than a generic DJ booking."
  },
  {
    title: "Interview Worthy",
    copy: "The visual world, act structure, and comeback narrative create a profile that feels editorial before the first question is asked."
  }
];

const mediaAngles = [
  "The return of Chip Lee through a fully authored performance identity",
  "Why The Performa reads like a live property, not just a DJ set",
  "How cinematic act design changes crowd behavior and promoter value",
  "A screening conversation around taste, staging, and next-era nightlife"
];
---
<BaseLayout title="Press Kit | The Performa" description="A promoter and media-facing press kit for The Performa: positioning, visual language, story arc, and screening interview request.">
  <section class="mx-auto max-w-6xl px-6 pt-8">
    <div class="relative overflow-hidden rounded-[2.3rem] border border-white/15 bg-black/60">
      <img src="/assets/img/0032ChipFiesta_4K.jpg" alt="" aria-hidden="true" class="h-[56vh] w-full object-cover opacity-45" />
      <div class="absolute inset-0 bg-[linear-gradient(135deg,rgba(242,84,45,0.32),rgba(7,7,11,0.44)_32%,rgba(7,7,11,0.96))]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(243,211,139,0.24),transparent_30%)]"></div>
      <div class="absolute inset-0 flex items-end">
        <div class="grid w-full gap-8 p-8 md:grid-cols-[1.15fr_0.85fr] md:p-10">
          <div class="max-w-3xl self-end">
            <p class="text-xs uppercase tracking-[0.36em] text-gold/90">Press Kit</p>
            <h1 class="mt-4 font-display text-5xl leading-[0.95] md:text-7xl">The Performa is not a booking. It is a reveal.</h1>
            <p class="mt-5 max-w-2xl text-base leading-relaxed text-white/78">
              Chip Lee returns as The Performa: a cinematic, high-authority live identity built for promoters who need a sharper sell, media who need a stronger story, and rooms that want to feel transformed instead of simply programmed.
            </p>
            <div class="mt-7 flex flex-wrap gap-3">
              <Button href="/book" variant="primary">Request Screening Interview</Button>
              <Button href="/watch" variant="ghost">Watch Signature Reels</Button>
            </div>
          </div>

          <div class="self-end rounded-[1.8rem] border border-white/15 bg-black/40 p-5 backdrop-blur-md">
            <p class="text-[10px] uppercase tracking-[0.28em] text-gold/85">Positioning Snapshot</p>
            <div class="mt-4 space-y-4">
              <div class="rounded-[1.2rem] border border-white/10 bg-black/35 p-4">
                <p class="text-[10px] uppercase tracking-[0.22em] text-white/48">Based In</p>
                <p class="mt-2 text-lg text-white/90">Atlanta, GA</p>
              </div>
              <div class="rounded-[1.2rem] border border-white/10 bg-black/35 p-4">
                <p class="text-[10px] uppercase tracking-[0.22em] text-white/48">Built For</p>
                <p class="mt-2 text-lg text-white/90">Luxury nightlife, festivals, private events, and editorial-facing cultural moments</p>
              </div>
              <div class="rounded-[1.2rem] border border-white/10 bg-black/35 p-4">
                <p class="text-[10px] uppercase tracking-[0.22em] text-white/48">Why It Books</p>
                <p class="mt-2 text-lg text-white/90">Because the concept sells atmosphere, identity, and press value before doors even open</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-8">
    <div class="grid gap-4 md:grid-cols-3">
      {proofCards.map((card) => (
        <div class="rounded-[1.6rem] border border-white/15 bg-[linear-gradient(180deg,rgba(255,255,255,0.04),rgba(255,255,255,0.01))] p-6">
          <p class="text-[10px] uppercase tracking-[0.28em] text-white/45">Why It Pops</p>
          <h2 class="mt-3 font-display text-3xl">{card.title}</h2>
          <p class="mt-3 text-sm leading-relaxed text-white/72">{card.copy}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-8">
    <div class="grid gap-6 lg:grid-cols-[0.95fr_1.05fr]">
      <div class="overflow-hidden rounded-[1.9rem] border border-white/15 bg-black/45">
        <img src="/assets/img/201NewChip_4K.jpg" alt="Chip Lee as The Performa portrait" class="h-full w-full object-cover" loading="lazy" />
      </div>
      <div class="rounded-[1.9rem] border border-white/15 bg-black/45 p-6 md:p-8">
        <p class="text-[10px] uppercase tracking-[0.3em] text-gold/85">For Promoters And Editors</p>
        <h2 class="mt-3 font-display text-3xl md:text-5xl">A one-of-one angle in a market full of interchangeable flyers.</h2>
        <p class="mt-4 text-sm leading-relaxed text-white/74">
          The Performa gives decision-makers more to work with than a name, a genre tag, and an availability request. It gives them a visual system, an act structure, a return narrative, and a performer who can sit inside nightlife, culture coverage, branded experiences, and premium event decks without losing edge.
        </p>
        <p class="mt-4 text-sm leading-relaxed text-white/74">
          This is what makes the project interview-worthy. There is a real frame to discuss: transformation, stage psychology, room control, visual authorship, and why the next era of performance should feel bigger than the playlist economy it replaces.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <Button href="/book" variant="gold">Book A Screening Conversation</Button>
          <a href="/media/press-kit.pdf" target="_blank" rel="noreferrer" class="inline-flex min-h-11 items-center rounded-full border border-white/25 px-5 py-3 text-xs uppercase tracking-[0.28em] text-white/78 transition hover:border-gold/35 hover:text-gold">Download PDF</a>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-8">
    <div class="rounded-[2rem] border border-white/15 bg-[linear-gradient(135deg,rgba(242,84,45,0.09),rgba(7,7,11,0.88))] p-6 md:p-8">
      <div class="grid gap-6 lg:grid-cols-[0.85fr_1.15fr]">
        <div>
          <p class="text-[10px] uppercase tracking-[0.3em] text-gold/85">Editorial Hooks</p>
          <h2 class="mt-3 font-display text-3xl md:text-4xl">Reasons to ask for the interview instead of just the assets.</h2>
        </div>
        <div class="grid gap-3 md:grid-cols-2">
          {mediaAngles.map((angle) => (
            <div class="rounded-[1.25rem] border border-white/12 bg-black/30 px-4 py-4 text-sm leading-relaxed text-white/76">
              {angle}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-8">
    <MotionReveal client:visible>
      <div class="grid gap-6 lg:grid-cols-3">
        {chapters.map((chapter) => (
          <a href={chapter.href} class="group overflow-hidden rounded-[1.8rem] border border-white/15 bg-black/45 transition hover:border-gold/35 hover:shadow-[0_0_60px_rgba(242,84,45,0.12)]">
            <div class="relative">
              <img src={chapter.image} alt={`${chapter.title} chapter artwork`} class="h-72 w-full object-cover transition duration-500 group-hover:scale-[1.03]" loading="lazy" />
              <div class="absolute inset-0 bg-[linear-gradient(180deg,transparent,rgba(7,7,11,0.9))]"></div>
              <div class="absolute inset-x-0 bottom-0 p-5">
                <p class="text-[10px] uppercase tracking-[0.28em] text-gold/90">{chapter.eyebrow}</p>
                <h2 class="mt-2 font-display text-3xl">{chapter.title}</h2>
              </div>
            </div>
            <div class="p-5">
              <p class="text-sm text-white/72">{chapter.copy}</p>
              <span class="mt-4 inline-flex text-[10px] uppercase tracking-[0.24em] text-gold/90">Open Narrative</span>
            </div>
          </a>
        ))}
      </div>
    </MotionReveal>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-16">
    <div class="grid gap-6 lg:grid-cols-[1.1fr_0.9fr]">
      <div class="rounded-[2rem] border border-gold/25 bg-[radial-gradient(circle_at_top_left,rgba(243,211,139,0.08),transparent_34%),linear-gradient(180deg,rgba(255,255,255,0.04),rgba(255,255,255,0.01))] p-6 md:p-8">
        <p class="text-[10px] uppercase tracking-[0.3em] text-gold/85">Screening Request</p>
        <h2 class="mt-3 font-display text-3xl md:text-5xl">If the room matters, the conversation should too.</h2>
        <p class="mt-4 max-w-2xl text-sm leading-relaxed text-white/74">
          Media outlets, promoters, curators, and brand teams looking for the next distinctive performance property should request a screening interview now. The Performa is built to headline attention before it headlines the night.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <Button href="/book" variant="primary">Request Screening Interview</Button>
          <Button href="/watch" variant="ghost">Review Visuals</Button>
        </div>
      </div>
      <div class="overflow-hidden rounded-[2rem] border border-white/15 bg-black/45">
        <img src="/assets/img/134NewChip_4K.jpg" alt="The Performa performance image for press kit" class="h-full w-full object-cover" loading="lazy" />
      </div>
    </div>
  </section>
</BaseLayout>
