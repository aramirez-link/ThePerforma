<script>
  import { getBrowserSupabaseClient } from "../../lib/supabaseBrowser";

  (() => {
    const gateStorageKey = "the-performa-story-media-kit-v1";
    const gate = document.getElementById("story-media-gate");
    const content = document.getElementById("story-press-content");
    const form = document.getElementById("story-media-gate-form");
    const status = document.getElementById("story-media-gate-status");

    if (!gate || !content || !form || !(form instanceof HTMLFormElement) || !status) return;

    const revealContent = () => {
      gate.hidden = true;
      content.hidden = false;
    };

    const showGate = () => {
      gate.hidden = false;
      content.hidden = true;
    };

    const readStoredAccess = () => {
      try {
        const raw = localStorage.getItem(gateStorageKey);
        if (!raw) return false;
        const parsed = JSON.parse(raw);
        return Boolean(parsed?.granted);
      } catch {
        return false;
      }
    };

    const persistAccess = (payload) => {
      try {
        localStorage.setItem(
          gateStorageKey,
          JSON.stringify({
            granted: true,
            ...payload,
            grantedAt: new Date().toISOString()
          })
        );
      } catch {}
    };

    const syncAccess = async () => {
      const supabase = getBrowserSupabaseClient();
      if (supabase) {
        try {
          const { data: sessionData } = await supabase.auth.getSession();
          if (sessionData?.session?.user) {
            const { data, error } = await supabase.rpc("is_store_admin");
            if (!error && data === true) {
              revealContent();
              return;
            }
          }
        } catch {}
      }

      if (readStoredAccess()) {
        revealContent();
        return;
      }

      showGate();
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      status.textContent = "";

      const formData = new FormData(form);
      const fullName = String(formData.get("name") || "").trim();
      const email = String(formData.get("email") || "").trim().toLowerCase();
      const phone = String(formData.get("phone") || "").trim();
      const interest = String(formData.get("interest") || "").trim();

      if (fullName.length < 2) {
        status.textContent = "Enter your full name.";
        return;
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        status.textContent = "Enter a valid email address.";
        return;
      }
      if (!interest) {
        status.textContent = "Select your interest.";
        return;
      }

      const submitButton = form.querySelector('button[type="submit"]');
      if (submitButton instanceof HTMLButtonElement) submitButton.disabled = true;
      status.textContent = "Opening the press kit...";

      const supabase = getBrowserSupabaseClient();
      if (!supabase) {
        status.textContent = "Media access is temporarily unavailable. Please try again shortly.";
        if (submitButton instanceof HTMLButtonElement) submitButton.disabled = false;
        return;
      }

      try {
        const { data: sessionData } = await supabase.auth.getSession();
        const userId = sessionData?.session?.user?.id || null;
        const { error } = await supabase.from("media_kit_requests").insert({
          user_id: userId,
          full_name: fullName,
          email,
          phone: phone || null,
          interest,
          source_path: "/story",
          metadata: {
            userAgent: navigator.userAgent,
            locale: navigator.language || "",
            referrer: document.referrer || "",
            pathname: window.location.pathname
          }
        });
        if (error) throw error;
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : "Could not submit your request.";
        if (submitButton instanceof HTMLButtonElement) submitButton.disabled = false;
        return;
      }

      persistAccess({ name: fullName, email, interest });
      revealContent();
    });

    void syncAccess();
    window.addEventListener("fanvault:changed", () => {
      void syncAccess();
    });
    document.addEventListener("astro:after-swap", () => {
      void syncAccess();
    });
  })();
</script>
