---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import DonatePill from "../../components/DonatePill.astro";
import PressFactCard from "../../components/press-kit/PressFactCard.astro";
import PressChapterCard from "../../components/press-kit/PressChapterCard.astro";
import PressResourceCard from "../../components/press-kit/PressResourceCard.astro";
import PressGalleryTile from "../../components/press-kit/PressGalleryTile.astro";

const canonical = "https://theperforma.com/story/";
const socialImage = "/assets/img/0032ChipFiesta_4K.jpg";
const gateStorageKey = "the-performa-story-media-kit-v1";

const quickFacts = [
  {
    label: "Based In",
    value: "Atlanta, Georgia",
    detail: "Built from Atlanta with a globally legible performance language shaped by rhythm, movement, and connection."
  },
  {
    label: "Availability",
    value: "Worldwide",
    detail: "Available for festivals, luxury nightlife, private events, branded activations, and international cultural programming."
  },
  {
    label: "Format",
    value: "Live Electronic Performance Experience",
    detail: "An immersive performance where electronic sound, live instrumentation, movement, and technology converge onstage."
  },
  {
    label: "Best For",
    value: "Luxury nightlife, festivals, private events, branded activations",
    detail: "Also built for cultural programming and international audiences seeking something participatory, energetic, and memorable."
  },
  {
    label: "Distinct Value",
    value: "Live energy, cross-cultural language, audience interaction",
    detail: "Dynamic stage presence, shared movement, and a room experience that feels alive in real time."
  }
];

const chapters = [
  {
    eyebrow: "Phase I",
    index: "01",
    title: "Connection",
    descriptor: "Music / Movement / Shared rhythm",
    copy: "Music and movement open the room and establish the shared rhythm between performer and audience.",
    href: "/story/exodus",
    image: "/assets/img/010ChipLee_CF2024_4K.jpg"
  },
  {
    eyebrow: "Phase II",
    index: "02",
    title: "Elevation",
    descriptor: "Live instruments / Choreography / Global sounds",
    copy: "Live instruments, choreography, and global sounds build momentum as energy rises across the crowd. The room transforms from spectators to participants.",
    href: "/story/journey",
    image: "/assets/img/096NewChip_4K.jpg"
  },
  {
    eyebrow: "Phase III",
    index: "03",
    title: "Impact",
    descriptor: "Peak / Release / Memory",
    copy: "The performance lands its strongest moments, the collective peak where sound, motion, and crowd energy converge into a moment the audience remembers long after the night ends.",
    href: "/story/return",
    image: "/assets/img/137NewChip_4K.jpg"
  }
];

const marketBlocks = [
  {
    title: "Universal Energy",
    copy: "The music blends global influences and modern electronic rhythm in a way that connects across cultures, languages, and room types."
  },
  {
    title: "Live Performance Impact",
    copy: "Movement, musicianship, and stage presence give the show a physical charge that feels more alive and immediate than a conventional DJ booking."
  },
  {
    title: "Audience Engagement",
    copy: "The crowd is part of the experience. Direct interaction, shared rhythm, and collective energy turn spectators into participants."
  },
  {
    title: "Event Versatility",
    copy: "The Performa adapts cleanly to festivals, luxury nightlife, private events, branded experiences, and cultural celebrations without losing identity."
  }
];

const editorialHooks = [
  "How live electronic performance is evolving beyond traditional DJ sets",
  "The fusion of global rhythms and modern performance technology",
  "Why audience interaction is becoming central to live music experiences",
  "The role of movement and choreography in electronic music performance",
  "How multicultural influences shape modern nightlife sound"
];

const gallery = [
  {
    src: "/assets/img/201NewChip_4K.jpg",
    alt: "Chip Lee portrait for The Performa press materials",
    label: "Portrait"
  },
  {
    src: "/assets/img/134NewChip_4K.jpg",
    alt: "The Performa live performance still with strong stage presence",
    label: "Live Performance"
  },
  {
    src: "/assets/img/0030ChipFiesta_4K.jpg",
    alt: "Cinematic promotional image for The Performa",
    label: "Promotional Visual"
  },
  {
    src: "/assets/img/CHIPLEE_LOGO_Clear.png",
    alt: "Chip Lee brand mark on transparent background",
    label: "Brand Mark"
  }
];

const resources = [
  {
    eyebrow: "Download",
    title: "Press Kit PDF",
    copy: "A direct leave-behind for editors, promoters, curators, and luxury event stakeholders.",
    href: "/media/press-kit.pdf",
    external: true,
    available: true
  },
  {
    eyebrow: "Assets",
    title: "Promo Photos",
    copy: "High-resolution portrait and performance stills suitable for editorial features, listings, and event decks.",
    href: "/assets/img/201NewChip_4K.jpg",
    external: true,
    available: true
  },
  {
    eyebrow: "Assets",
    title: "Logo Pack",
    copy: "Clear-mark access for branded placements, digital flyers, pitch decks, and sponsor collateral.",
    href: "/assets/img/CHIPLEE_LOGO_Clear.png",
    external: true,
    available: true
  },
  {
    eyebrow: "Contact",
    title: "Interview Requests",
    copy: "For screening conversations, features, podcasts, cultural editorial, and premium press opportunities.",
    href: "/book",
    available: true
  },
  {
    eyebrow: "Visuals",
    title: "Signature Reels",
    copy: "Review the performance language, live pacing, and visual identity through the current reel library.",
    href: "/watch",
    available: true
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfilePage",
      "@id": `${canonical}#page`,
      url: canonical,
      name: "The Performa Press Kit",
      description:
        "Premium press kit and electronic press page for The Performa, the live electronic performance identity of Chip Lee.",
      about: {
        "@id": "https://theperforma.com/#artist"
      }
    },
    {
      "@type": "MusicGroup",
      "@id": "https://theperforma.com/#artist",
      name: "The Performa",
      alternateName: "Chip Lee - The Performa",
      description:
        "The live electronic performance identity of Chip Lee, built as a cinematic DJ and performance experience structured across Exodus, Journey, and Return.",
      genre: ["Electronic", "Live performance", "Cinematic DJ experience"],
      homeLocation: {
        "@type": "City",
        name: "Atlanta, GA"
      },
      sameAs: [
        "https://www.youtube.com/@chipleetheperforma",
        "https://soundcloud.com/chipleetheperforma"
      ]
    }
  ]
};
---
<BaseLayout
  title="The Performa Press Kit | Cinematic Live Electronic Performance Experience"
  description="Media-ready electronic press kit for The Performa, the cinematic live performance identity of Atlanta artist Chip Lee. Built for promoters, editors, festival buyers, luxury nightlife, and branded experiences."
  canonical={canonical}
  image={socialImage}
  schema={schema}
>
  <section id="story-media-gate" class="mx-auto max-w-4xl px-4 pt-8 sm:px-6">
    <div class="relative overflow-hidden rounded-[2.2rem] border border-white/15 bg-black/60 p-6 md:p-8" data-reveal>
      <img src="/assets/img/201NewChip_4K.jpg" alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover opacity-20" />
      <div class="absolute inset-0 bg-[linear-gradient(135deg,rgba(242,84,45,0.16),rgba(7,7,11,0.9))]"></div>
      <div class="relative grid gap-6 lg:grid-cols-[0.92fr_1.08fr]">
        <div>
          <p class="text-[10px] uppercase tracking-[0.34em] text-gold/90">Media Access</p>
          <h1 class="mt-4 font-display text-4xl md:text-5xl">Request the Press Kit</h1>
          <p class="mt-4 text-sm leading-relaxed text-white/74 md:text-base">
            The Performa press kit is reserved for media, promoters, curators, buyers, and brand teams evaluating Chip Lee, thePerforma. Share your details to enter the full dossier.
          </p>
          <div class="mt-6 space-y-3 text-sm text-white/62">
            <p>Inside: positioning, booking snapshot, artist narrative, chapter architecture, visual assets, and evaluation resources.</p>
          </div>
        </div>
        <div class="rounded-[1.8rem] border border-white/12 bg-black/40 p-5 md:p-6">
          <form id="story-media-gate-form" class="grid gap-4">
            <div>
              <label for="story-gate-name" class="mb-2 block text-[10px] uppercase tracking-[0.28em] text-white/55">Name</label>
              <input id="story-gate-name" name="name" class="min-h-12 w-full rounded-2xl border border-white/15 bg-black/45 px-4 py-3 text-white placeholder:text-white/35 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold" placeholder="Full name" autocomplete="name" required />
            </div>
            <div>
              <label for="story-gate-email" class="mb-2 block text-[10px] uppercase tracking-[0.28em] text-white/55">Email</label>
              <input id="story-gate-email" name="email" type="email" class="min-h-12 w-full rounded-2xl border border-white/15 bg-black/45 px-4 py-3 text-white placeholder:text-white/35 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold" placeholder="name@company.com" autocomplete="email" required />
            </div>
            <div>
              <label for="story-gate-phone" class="mb-2 block text-[10px] uppercase tracking-[0.28em] text-white/55">Phone</label>
              <input id="story-gate-phone" name="phone" type="tel" class="min-h-12 w-full rounded-2xl border border-white/15 bg-black/45 px-4 py-3 text-white placeholder:text-white/35 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold" placeholder="Phone number" autocomplete="tel" />
            </div>
            <div>
              <label for="story-gate-interest" class="mb-2 block text-[10px] uppercase tracking-[0.28em] text-white/55">Interest</label>
              <select id="story-gate-interest" name="interest" class="min-h-12 w-full rounded-2xl border border-white/15 bg-black/45 px-4 py-3 text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold" required>
                <option value="">Select interest</option>
                <option value="booking">Booking conversation</option>
                <option value="media">Media / editorial</option>
                <option value="festival">Festival / talent buying</option>
                <option value="brand">Brand partnership</option>
                <option value="private-event">Private event</option>
                <option value="screening">Screening interview</option>
              </select>
            </div>
            <p id="story-media-gate-status" class="min-h-5 text-sm text-white/68" aria-live="polite"></p>
            <button type="submit" class="inline-flex min-h-12 items-center justify-center rounded-full bg-ember px-6 py-3 text-xs font-semibold uppercase tracking-[0.26em] text-ink shadow-[0_0_28px_rgba(242,84,45,0.35)] transition hover:shadow-[0_0_36px_rgba(242,84,45,0.5)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold">
              Enter Press Kit
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <div id="story-press-content" hidden>
  <section class="mx-auto max-w-6xl px-4 pt-8 sm:px-6">
    <div class="relative overflow-hidden rounded-[2.4rem] border border-white/15 bg-black/60" data-reveal>
      <img src="/assets/img/0032ChipFiesta_4K.jpg" alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover object-center opacity-40" />
      <div class="absolute inset-0 bg-[linear-gradient(130deg,rgba(242,84,45,0.28),rgba(7,7,11,0.2)_24%,rgba(7,7,11,0.86)_62%,rgba(7,7,11,0.98))]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(243,211,139,0.2),transparent_28%)]"></div>
      <div class="absolute inset-0 bg-[linear-gradient(180deg,transparent,rgba(7,7,11,0.26)_35%,rgba(7,7,11,0.9))]"></div>
      <div class="relative grid gap-10 p-6 md:p-10 lg:grid-cols-[minmax(0,1.12fr)_minmax(21rem,0.88fr)] lg:items-start lg:gap-14 lg:p-12">
        <div class="max-w-none">
          <p class="text-xs uppercase tracking-[0.38em] text-gold/90">Press Kit / Electronic Press Page</p>
            <h1 class="mt-5 max-w-[11ch] font-display text-[clamp(2.9rem,4.2vw,4.6rem)] leading-[0.92]">Music is only the beginning.</h1>
            <p class="mt-6 max-w-[46rem] text-base leading-relaxed text-white/80 md:text-lg">
              The Performa is the live performance identity of Atlanta artist Chip Lee: an immersive musical experience where electronic sound, live instrumentation, choreography, and technology converge into a single performance environment.
            </p>
            <p class="mt-5 max-w-[46rem] text-sm leading-8 text-white/66 md:text-base">
              Rather than standing behind a booth delivering a sequence of tracks, Chip Lee transforms the stage into a living experience. Movement, rhythm, visual energy, and audience interaction turn each performance into a shared moment between artist and crowd, less like a DJ set and more like a cultural event unfolding in real time.
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
              <Button href="/book" variant="primary">Request Screening Interview</Button>
              <Button href="/watch" variant="ghost">Watch Signature Reels</Button>
              <a
                href="/media/press-kit.pdf"
                target="_blank"
                rel="noreferrer"
                class="inline-flex min-h-11 items-center justify-center rounded-full border border-white/20 px-5 py-3 text-xs font-semibold uppercase tracking-[0.22em] text-white/82 transition hover:border-gold/35 hover:text-gold focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold"
              >
                Download Press Kit PDF
              </a>
            </div>
        </div>

        <aside class="rounded-[1.9rem] border border-white/12 bg-[linear-gradient(180deg,rgba(0,0,0,0.42),rgba(255,255,255,0.03))] p-5 backdrop-blur-md md:p-6 lg:mt-20 lg:max-w-[30rem]">
          <p class="text-[10px] uppercase tracking-[0.3em] text-gold/85">Booking Snapshot</p>
          <div class="mt-5 space-y-5">
            <div class="rounded-[1.35rem] border border-white/12 bg-black/30 p-4">
              <p class="text-[10px] uppercase tracking-[0.24em] text-white/45">Format</p>
              <p class="mt-2 text-lg leading-snug text-white/90">Live Electronic Performance Experience</p>
            </div>
            <div class="rounded-[1.35rem] border border-white/12 bg-black/30 p-4">
              <p class="text-[10px] uppercase tracking-[0.24em] text-white/45">Based In / Availability</p>
              <p class="mt-2 text-lg leading-snug text-white/90">Atlanta, Georgia / Worldwide</p>
            </div>
            <div class="rounded-[1.35rem] border border-white/12 bg-black/30 p-4">
              <p class="text-[10px] uppercase tracking-[0.24em] text-white/45">Commercial Value</p>
              <p class="mt-2 text-lg leading-snug text-white/90">Live performance energy, cross-cultural language, audience interaction, dynamic stage presence</p>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 md:py-14">
    <div class="rounded-[2rem] border border-white/12 bg-[linear-gradient(135deg,rgba(255,255,255,0.04),rgba(255,255,255,0.01))] p-5 md:p-8" data-reveal>
      <div class="grid gap-6 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
        <div class="max-w-2xl">
          <p class="text-[10px] uppercase tracking-[0.32em] text-gold/85">Quick Facts</p>
          <h2 class="mt-3 font-display text-3xl leading-[0.98] md:text-5xl">A premium booking snapshot for buyers, media, and brand teams.</h2>
        </div>
        <p class="max-w-2xl text-sm leading-7 text-white/66 lg:justify-self-end lg:text-right">
          Designed to be scanned in seconds and remembered long after. This is the short-form view of what thePerforma is, where it plays, and why it stands apart.
        </p>
      </div>
      <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {quickFacts.map((fact) => (
          <PressFactCard {...fact} />
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-10 sm:px-6 md:pb-14">
    <div class="grid gap-6 lg:grid-cols-[0.88fr_1.12fr]" data-reveal>
      <div class="overflow-hidden rounded-[2rem] border border-white/15 bg-black/45">
        <img src="/assets/img/201NewChip_4K.jpg" alt="Chip Lee portrait for The Performa press kit" class="h-full min-h-[24rem] w-full object-cover" loading="lazy" />
      </div>
      <div class="grid gap-6">
        <article class="rounded-[2rem] border border-white/12 bg-[linear-gradient(180deg,rgba(255,255,255,0.04),rgba(255,255,255,0.01))] p-6 md:p-8">
          <p class="text-[10px] uppercase tracking-[0.32em] text-gold/85">Short Press Bio</p>
          <h2 class="mt-3 font-display text-3xl md:text-4xl">A press-ready summary that can travel cleanly into listings, features, and introductions.</h2>
          <p class="mt-4 text-base leading-relaxed text-white/78">
            The Performa is the live electronic performance identity of Atlanta artist Chip Lee. Blending electronic music, live instrumentation, choreography, and interactive stage presence, The Performa delivers a high-energy performance experience designed to move audiences both physically and emotionally. Built to connect across cultures and audiences, the show combines global musical influences with modern performance technology to create a dynamic environment where the artist and audience move together. The Performa is not just music. It is movement, rhythm, culture, and connection.
          </p>
        </article>
        <article class="rounded-[2rem] border border-white/12 bg-black/45 p-6 md:p-8">
          <p class="text-[10px] uppercase tracking-[0.32em] text-gold/85">The Idea</p>
          <h2 class="mt-3 font-display text-3xl md:text-4xl">Chip Lee built thePerforma around a simple belief: music should bring people together.</h2>
          <div class="mt-5 space-y-5 text-sm leading-8 text-white/74 md:text-base">
            <p>
              Across cultures, languages, and backgrounds, rhythm is one of the most universal forms of communication. The Performa reflects that idea by blending sounds, movements, and influences from multiple musical traditions into a performance that feels welcoming, celebratory, and alive.
            </p>
            <p>
              The experience is designed as a multi-dimensional live performance where music, movement, live instrumentation, audience interaction, and technology work together on the same stage. Electronic and global rhythms move between cultures, tempos, and moods while live musicians add improvisation, texture, and organic energy.
            </p>
            <p>
              Whether the room is a nightclub, festival stage, private event, or cultural gathering, the goal is the same: create an atmosphere where everyone in the room feels part of the moment. The Performa thrives on shared energy between performer and audience, turning spectators into participants.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-10 sm:px-6 md:pb-14">
    <div class="rounded-[2.2rem] border border-white/15 bg-[linear-gradient(135deg,rgba(242,84,45,0.12),rgba(7,7,11,0.86))] p-6 md:p-8 lg:p-10" data-reveal>
      <div class="max-w-3xl">
        <p class="text-[10px] uppercase tracking-[0.32em] text-gold/85">The Experience</p>
        <h2 class="mt-3 font-display text-3xl md:text-5xl">A three-chapter show architecture designed for escalation, memory, and room control.</h2>
        <p class="mt-4 text-sm leading-relaxed text-white/70 md:text-base">
          The Performa is designed as a multi-dimensional live performance where music, live instrumentation, movement, technology, and audience connection converge into a single shared environment.
        </p>
      </div>
      <div class="mt-8 grid gap-6 lg:grid-cols-3">
        {chapters.map((chapter) => (
          <PressChapterCard {...chapter} />
        ))}
      </div>
      <div class="mt-10 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        <article class="rounded-[1.4rem] border border-white/12 bg-black/30 p-5">
          <p class="text-[10px] uppercase tracking-[0.28em] text-gold/85">Music</p>
          <p class="mt-3 text-sm leading-relaxed text-white/74">Electronic and global rhythms blend into a sound that moves between cultures, tempos, and moods.</p>
        </article>
        <article class="rounded-[1.4rem] border border-white/12 bg-black/30 p-5">
          <p class="text-[10px] uppercase tracking-[0.28em] text-gold/85">Live Instrumentation</p>
          <p class="mt-3 text-sm leading-relaxed text-white/74">Live musicians expand the performance beyond playback, adding texture, improvisation, and organic energy.</p>
        </article>
        <article class="rounded-[1.4rem] border border-white/12 bg-black/30 p-5">
          <p class="text-[10px] uppercase tracking-[0.28em] text-gold/85">Movement & Choreography</p>
          <p class="mt-3 text-sm leading-relaxed text-white/74">Chip Lee moves with the music, engaging directly with the crowd and turning the stage into a kinetic performance space.</p>
        </article>
        <article class="rounded-[1.4rem] border border-white/12 bg-black/30 p-5">
          <p class="text-[10px] uppercase tracking-[0.28em] text-gold/85">Technology</p>
          <p class="mt-3 text-sm leading-relaxed text-white/74">Lighting, sound design, and performance technology elevate the atmosphere and shape emotional flow.</p>
        </article>
        <article class="rounded-[1.4rem] border border-white/12 bg-black/30 p-5 md:col-span-2 xl:col-span-1">
          <p class="text-[10px] uppercase tracking-[0.28em] text-gold/85">Audience Connection</p>
          <p class="mt-3 text-sm leading-relaxed text-white/74">Direct interaction is central to the show, turning spectators into participants through shared energy and movement.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-10 sm:px-6 md:pb-14">
    <div class="grid gap-6 lg:grid-cols-[0.82fr_1.18fr]" data-reveal>
      <div class="rounded-[2rem] border border-white/12 bg-black/45 p-6 md:p-8">
        <p class="text-[10px] uppercase tracking-[0.32em] text-gold/85">Why It Books</p>
        <h2 class="mt-3 font-display text-3xl md:text-5xl">A performance designed to move the room.</h2>
        <p class="mt-4 text-sm leading-relaxed text-white/72 md:text-base">
          The Performa offers event producers and promoters something more dynamic than a traditional DJ booking: a performance experience that engages audiences visually, musically, and physically.
        </p>
      </div>
      <div class="grid gap-4 md:grid-cols-2">
        {marketBlocks.map((block) => (
          <article class="rounded-[1.6rem] border border-white/12 bg-[linear-gradient(180deg,rgba(255,255,255,0.05),rgba(255,255,255,0.02))] p-6">
            <p class="text-[10px] uppercase tracking-[0.28em] text-white/45">Market Differentiation</p>
            <h3 class="mt-3 text-2xl font-semibold text-white/92">{block.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-white/68">{block.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-10 sm:px-6 md:pb-14">
    <div class="rounded-[2rem] border border-white/12 bg-black/45 p-6 md:p-8" data-reveal>
      <div class="grid gap-6 lg:grid-cols-[0.88fr_1.12fr] lg:items-end">
        <div class="max-w-2xl">
          <p class="text-[10px] uppercase tracking-[0.32em] text-gold/85">Editorial Hooks</p>
          <h2 class="mt-3 font-display text-3xl md:text-5xl">Useful story angles for editors, interviewers, podcasters, and culture media.</h2>
        </div>
        <p class="max-w-2xl text-sm leading-7 text-white/66 lg:justify-self-end lg:text-right">
          These angles are designed for editors, hosts, and interviewers looking at how live electronic performance is changing and why audience connection now sits at the center of the room.
        </p>
      </div>
      <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {editorialHooks.map((hook) => (
          <article class="rounded-[1.4rem] border border-white/12 bg-[linear-gradient(180deg,rgba(255,255,255,0.04),rgba(255,255,255,0.01))] p-5">
            <p class="text-sm leading-relaxed text-white/76">{hook}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-10 sm:px-6 md:pb-14">
    <div class="grid gap-6 lg:grid-cols-[0.78fr_1.22fr]" data-reveal>
